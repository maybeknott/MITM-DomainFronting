# Lab-only: block TLS ClientHello with plaintext SNI matching blocked.example
# SID 9000001 — used by scripts/wire_proof_suricata.py manifest
alert tls any any -> any any (
    msg:"MITM lab DPI block plaintext SNI";
    flow:established,to_server;
    tls.sni; content:"blocked.example";
    sid:9000001;
    rev:1;
)
